{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/watch-digest",
      "destination": "/api/product?service=watch&action=digest"
    },
    {
      "source": "/api/watch",
      "destination": "/api/product?service=watch"
    },
    {
      "source": "/api/newsletter-draft",
      "destination": "/api/product?service=newsletter&action=draft"
    },
    {
      "source": "/api/pro",
      "destination": "/api/product?service=pro"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/product?service=newsletter"
    },
    {
      "source": "/api/paystack-webhook",
      "destination": "/api/product?service=paystack-webhook"
    },
    {
      "source": "/quiz",
      "destination": "/api/quiz-page"
    },
    {
      "source": "/studio/:path*",
      "destination": "/api/view?path=studio/:path*"
    },
    {
      "source": "/receipt/:id",
      "destination": "/api/view?path=receipt/:id"
    },
    {
      "source": "/current/:artist",
      "destination": "/api/view?path=current/:artist"
    },
    {
      "source": "/quiz/:artist",
      "destination": "/api/quiz-page?artist=:artist"
    },
    {
      "source": "/u/:username",
      "destination": "/api/view?path=u/:username"
    },
    {
      "source": "/week/:week",
      "destination": "/api/view?path=week/:week"
    },
    {
      "source": "/vs/:path*",
      "destination": "/api/view?path=vs/:path*"
    },
    {
      "source": "/boards/:path*",
      "destination": "/api/view?path=boards/:path*"
    },
    {
      "source": "/calendar/:path*",
      "destination": "/api/view?path=calendar/:path*"
    },
    {
      "source": "/account",
      "destination": "/api/view?path=account"
    },
    {
      "source": "/discover",
      "destination": "/api/view?path=studio"
    },
    {
      "source": "/collaborations",
      "destination": "/api/view?path=studio/graph"
    }
  ],
  "functions": {
    "api/card.js": {
      "includeFiles": "assets/DejaVuSans.ttf"
    },
    "api/quiz-page.js": {
      "includeFiles": "quiz.html"
    }
  },
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/studio/boards",
      "destination": "/boards",
      "permanent": true
    },
    {
      "source": "/studio/calendar",
      "destination": "/calendar/awards",
      "permanent": true
    },
    {
      "source": "/studio/board",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "current"
        }
      ],
      "destination": "/current",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "alltime"
        }
      ],
      "destination": "/all-time",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "albums"
        }
      ],
      "destination": "/albums",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "networth"
        }
      ],
      "destination": "/net-worth",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "method"
        }
      ],
      "destination": "/method",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "underground"
        }
      ],
      "destination": "/watch",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "vs"
        }
      ],
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "receipt"
        }
      ],
      "destination": "/music-receipt",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "regions"
        }
      ],
      "destination": "/regions",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "yearly"
        }
      ],
      "destination": "/releases",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "artists"
        }
      ],
      "destination": "/artists",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "discuss"
        }
      ],
      "destination": "/discussion",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "news"
        }
      ],
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "top100"
        }
      ],
      "destination": "/top100",
      "permanent": true
    },
    {
      "source": "/underground",
      "destination": "/watch",
      "permanent": true
    },
    {
      "source": "/underground.html",
      "destination": "/watch",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter-draft",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/watch-digest",
      "schedule": "0 9 * * 0"
    }
  ]
}